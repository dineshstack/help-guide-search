# Copy this file to .env and put in the real values for your machine.
# .env is ignored by git. Real values are never committed.

# Where Postgres is. The password below is a placeholder, not a real one.
DATABASE_URL=postgresql://postgres:change-me-not-a-real-password@127.0.0.1:54329/guides

# A separate database that the integration tests are free to empty.
# The tests read this one and never DATABASE_URL, so they cannot wipe the real index.
TEST_DATABASE_URL=postgresql://postgres:change-me-not-a-real-password@127.0.0.1:54329/guides_test

# Only needed to run the title-picking baseline.
# Search, the tests and rebuilding the report work without it.
ANTHROPIC_API_KEY=
